{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Package Readiness v1",
  "type": "object",
  "required": [
    "package_id",
    "required_files_present",
    "checksums_present",
    "manifest_present",
    "readme_present",
    "evidence_complete",
    "ready_state"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique package identifier"
    },
    "required_files_present": {
      "type": "boolean",
      "description": "Whether all required files are present"
    },
    "checksums_present": {
      "type": "boolean",
      "description": "Whether checksum artifacts exist"
    },
    "manifest_present": {
      "type": "boolean",
      "description": "Whether export/package manifest exists"
    },
    "readme_present": {
      "type": "boolean",
      "description": "Whether package README exists"
    },
    "evidence_complete": {
      "type": "boolean",
      "description": "Whether required PASS/FAIL evidence is complete"
    },
    "ready_state": {
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "blocked"
      ]
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Optional readiness note"
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "description": "Required explanation if ready_state is blocked"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ready_state": { "const": "blocked" }
        }
      },
      "then": {
        "required": ["blocked_reason"]
      }
    }
  ],
  "additionalProperties": false
}